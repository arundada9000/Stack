# -------------------------
# EasyStack .gitignore
# -------------------------

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor and IDE files ---
.idea/
.vscode/
*.suo
*.user
*.swp
*.swo
*~

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Build output and dependencies ---
node_modules/
dist/
build/

# --- Environment and secrets ---
.env
.env.*
*.pem
*.key

# --- Search Console export folders ---
https___easystack.netlify.app_*/

# --- Temp files ---
*.tmp
*.temp
*.bak
*.old
